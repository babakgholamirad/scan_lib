// ============================================================================
// Shared menu input and display helpers
// Validates numbered choices, formats result labels, and validates target IPs.
// This source is included by scan_lib.txt with Grey Hack import_code.
// ============================================================================

// Return a zero-based choice, -1 for quit/cancel, or -2 for an allowed back action.
select_index = function(prompt, item_count, allow_back)
	while true
		answer = user_input(prompt)
		// Treat closed input and q as cancellation for every caller.
		if answer == null then return -1
		if answer.lower() == "q" then return -1
		if allow_back and answer.lower() == "b" then return -2
		// Compare against valid indices as text to reject malformed values safely.
		index = item_count - 1
		while index >= 0
			if answer == index + "" then return index
			index = index - 1
		end while
		// Explain the accepted controls and reprompt without leaving the menu.
		if allow_back then
			print("Invalid selection. Enter a listed number, b to go back, or q to quit.")
		else
			print("Invalid selection. Enter a listed number or q to quit.")
		end if
	end while
end function

// Color a user name using the same root/guest distinction as 5hell.
user_color = function(user)
	if user == "root" then return "<color=#FF0000FF><b>" + user + "</color></b>"
	if user == "guest" then return "<color=#FFFFFFFF><b>" + user + "</color></b>"
	return "<color=#00FFFFFF><b>" + user + "</color></b>"
end function

// Color an object type so shell, computer, and file results stand out.
object_color = function(result_type)
	if result_type == "file" then return "<color=#00FF00FF><b>" + result_type + "</color></b>"
	if result_type == "computer" then return "<color=#00FFFFFF><b>" + result_type + "</color></b>"
	if result_type == "shell" then return "<color=#CCCC00FF><b>" + result_type + "</color></b>"
	return result_type
end function

// Reject malformed target addresses before any network call.
is_valid_target_ip = function(address)
	if address == null then return false
	return is_valid_ip(address)
end function
