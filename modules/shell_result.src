// ============================================================================
// Shell result menu
// Contains remote shell actions, upload helpers, mail handling, and trace tool setup.
// This source is included by scan_lib.txt with Grey Hack import_code.
// ============================================================================

// Return readable folders in the remote shell's /home directory, or null on failure.
get_shell_home_users = function(shell)
	// Every guard below must pass before the folder list is usable by the menus.
	computer = shell.host_computer
	if not computer then return null
	home_folder = computer.File("/home")
	if not home_folder then return null
	if not home_folder.is_folder then return null
	if not home_folder.has_permission("r") then return null
	folders = home_folder.get_folders
	if typeof(folders) != "list" then return null
	return folders
end function

// Determine the user behind a shell or computer from writable filesystem access.
check_user = function(obj)
	if obj == null then return "unknown"
	obj_type = typeof(obj)
	computer = null
	if obj_type == "shell" or obj_type == "ftpshell" then
		computer = obj.host_computer
	else if obj_type == "computer" then
		computer = obj
	end if
	if not computer then return "unknown"
	// A writable root folder means the object has root privileges.
	root_folder = computer.File("/")
	if root_folder and root_folder.has_permission("w") then return "root"
	// Otherwise the writable home folder identifies the user; guest is the fallback.
	home_folder = computer.File("/home")
	if not home_folder then return "unknown"
	folders = home_folder.get_folders
	if typeof(folders) != "list" then return "guest"
	for folder in folders
		if folder.name != "guest" and folder.has_permission("w") then return folder.name
	end for
	return "guest"
end function

get_shell_user = function(shell)
	return check_user(shell)
end function

// Find a readable local app in the standard binary folders or the bundled tools folder.
find_local_app = function(app_name)
	local_computer = get_shell.host_computer
	if not local_computer then return null
	for path in ["/usr/bin/" + app_name, "/bin/" + app_name, current_path + "/tools/" + app_name]
		local_file = local_computer.File(path)
		if local_file and local_file.has_permission("r") then return path
	end for
	return null
end function

// Prefer the target's own app, then fall back to a readable local copy for upload.
find_app = function(shell, app_name)
	computer = shell.host_computer
	if not computer then return null
	for path in ["/usr/bin/" + app_name, "/bin/" + app_name]
		remote_file = computer.File(path)
		if remote_file and remote_file.has_permission("x") then
			return {"path": path, "remote": true}
		end if
	end for
	local_path = find_local_app(app_name)
	if local_path then return {"path": local_path, "remote": false}
	return null
end function

// Upload one file and normalize the scp result for callers.
upload_file = function(local_path, remote_dir, shell)
	result = get_shell.scp(local_path, remote_dir, shell, false)
	if result == true then return true
	return result
end function

// Delete only the paths this session recorded as uploaded by scan_lib.
clear_uploaded_files = function(shell, uploaded_files)
	computer = shell.host_computer
	if not computer then
		print("Could not access the remote computer to remove uploaded files.")
		return
	end if
	if uploaded_files.len() == 0 then
		return
	end if
	// Delete each recorded upload and verify it is actually gone afterwards.
	for uploaded_path in uploaded_files
		remote_file = computer.File(uploaded_path)
		if remote_file then
			remote_file.delete
			if computer.File(uploaded_path) then
				print("Could not permanently remove " + uploaded_path)
			else
				print("Permanently removed " + uploaded_path)
			end if
		end if
	end for
end function

// Find a log utility remotely or upload a readable local copy into a staging folder.
prepare_log_tool = function(shell, app_name, uploaded_files)
	app = find_app(shell, app_name)
	if not app then
		print("Could not find " + app_name + " on the target or in /usr/bin, /bin, or " + current_path + "/tools/.")
		return null
	end if
	// Reuse the target's own copy when the tool is already installed there.
	if app.remote then
		print(app_name + " is already available on the target.")
		return app.path
	end if

	remote_tools_path = "/home/guest/scan_lib_tools"
	print("Preparing remote app folder " + remote_tools_path + "...")
	// /bin/mkdir here takes a single path and ignores an already-existing folder.
	shell.launch("/bin/mkdir", remote_tools_path + "/")
	remote_app_path = remote_tools_path + "/" + app_name
	uploaded_files.push(remote_app_path)
	print("Uploading " + app_name + "...")
	// scp treats the destination as a directory, so the basename is retained.
	upload_result = upload_file(app.path, remote_tools_path, shell)
	if upload_result != true then
		print("Could not upload " + app_name + ": " + upload_result)
		return null
	end if
	return remote_app_path
end function

// List the ports the target router reports for one LAN address.
discover_lan_ports = function(address)
	router = get_router(address)
	if not router then return null
	ports = router.device_ports(address)
	if typeof(ports) != "list" then return null
	records = []
	for port in ports
		service = "unknown"
		version = "-"
		info = router.port_info(port)
		if info then
			parts = info.split(" ")
			if parts.len > 0 and parts[0] != "" then service = parts[0]
			if parts.len > 1 then version = parts[1]
		end if
		records.push({"port": port.port_number, "service": service, "version": version})
	end for
	return records
end function

// Return the directory portion of an absolute path.
dir_name = function(path)
	parts = path.split("/")
	if parts.len <= 1 then return "/"
	parts.pop
	return parts.join("/")
end function

// Create each missing directory in an absolute path on the remote shell.
ensure_remote_dir = function(shell, path)
	parts = path.split("/")
	current = ""
	for part in parts
		if part == "" then continue
		current = current + "/" + part
		if not shell.host_computer.File(current) then
			shell.launch("/bin/mkdir", current)
		end if
	end for
end function

// Locate the running scanner's source file next to the installed program.
find_scanner_source = function()
	program_dir = dir_name(program_path)
	program_name = program_path.split("/")[-1]
	candidates = [
		program_dir + "/scan_lib.txt",
		program_dir + "/scan_lib.src",
		program_dir + "/" + program_name + ".src",
		home_dir + "/tools/scan_lib.txt",
		home_dir + "/tools/scan_lib.src",
		home_dir + "/tools/" + program_name + ".src",
		current_path + "/scan_lib.txt",
		current_path + "/scan_lib.src",
		program_path
	]
	for path in candidates
		source_file = get_shell.host_computer.File(path)
		if source_file and source_file.has_permission("r") and source_file.content != null then
			if source_file.content.indexOf("import_code") != null then
				return {"path": path, "content": source_file.content}
			end if
		end if
	end for
	return null
end function

// Copy the scanner and its modules to the remote shell, build it there, and scan an IP.
run_scanner_on_shell = function(shell)
	target_ip = user_input("Target IP to scan from this shell (b to cancel): ")
	if target_ip == null then return
	target_ip = target_ip.trim()
	if target_ip.lower() == "b" then return
	if not is_valid_target_ip(target_ip) then
		print("Invalid IP address: " + target_ip)
		return
	end if

	source = find_scanner_source()
	if source == null then
		print("Could not find the local scan_lib source next to " + program_path + ".")
		return
	end if

	// Collect the module paths declared by the scanner's import_code lines.
	import_paths = []
	for line in source.content.split(char(10))
		line = line.trim()
		if line[:12] == "import_code(" then
			parts = line.split(char(34))
			if parts.len >= 3 then import_paths.push(parts[1])
		end if
	end for
	if import_paths.len() == 0 then
		print("No import_code paths were found in the local scanner source.")
		return
	end if

	program_dir = dir_name(source.path)
	remote_source_name = "scan_lib_remote.src"
	remote_source_path = program_dir + "/" + remote_source_name
	remote_tools_dir = program_dir + "/tools"

	print("Preparing " + program_dir + " on the target...")
	ensure_remote_dir(shell, program_dir)
	ensure_remote_dir(shell, remote_tools_dir)

	// Copy each imported module to the same absolute path on the target.
	for import_path in import_paths
		module_dir = dir_name(import_path)
		ensure_remote_dir(shell, module_dir)
		print("Uploading " + import_path + "...")
		upload_result = upload_file(import_path, module_dir, shell)
		if upload_result != true then
			print("Could not upload " + import_path + ": " + upload_result)
			return
		end if
	end for

	// Point the scanner's metaxploit fallback at the copied tools folder.
	remote_content = source.content.replace("current_path + " + char(34) + "/tools/metaxploit.so" + char(34), char(34) + remote_tools_dir + "/metaxploit.so" + char(34))

	// Write the scanner source to a local temporary file so it can be uploaded as .src.
	local_temp_path = home_dir + "/" + remote_source_name
	local_temp = get_shell.host_computer.File(local_temp_path)
	if local_temp then local_temp.delete
	get_shell.host_computer.touch(home_dir, remote_source_name)
	local_temp = get_shell.host_computer.File(local_temp_path)
	if not local_temp then
		print("Could not create the local temporary source file.")
		return
	end if
	local_temp.set_content(remote_content)
	print("Uploading scanner source...")
	upload_result = upload_file(local_temp_path, program_dir, shell)
	local_temp.delete
	if upload_result != true then
		print("Could not upload the scanner source: " + upload_result)
		return
	end if

	// The target must be able to load metaxploit.so from /lib or the copied tools folder.
	remote_meta = shell.host_computer.File("/lib/metaxploit.so")
	if not remote_meta or not remote_meta.has_permission("r") then
		local_meta_path = null
		for path in ["/lib/metaxploit.so", program_dir + "/tools/metaxploit.so", current_path + "/tools/metaxploit.so", "/usr/bin/metaxploit.so", "/bin/metaxploit.so"]
			local_meta = get_shell.host_computer.File(path)
			if local_meta and local_meta.has_permission("r") then
				local_meta_path = path
				break
			end if
		end for
		if local_meta_path then
			print("Uploading metaxploit.so to the target...")
			upload_result = upload_file(local_meta_path, remote_tools_dir, shell)
			if upload_result != true then
				print("Could not upload metaxploit.so: " + upload_result)
				return
			end if
		else
			print("Warning: no local metaxploit.so was found; the target must already have one.")
		end if
	end if

	print("Building scanner on the target...")
	build_result = shell.build(remote_source_path, program_dir)
	if build_result then
		print("Build failed: " + build_result)
		return
	end if

	print("Launching scanner on the target...")
	launch_result = shell.launch(program_dir + "/scan_lib_remote", target_ip)
	if launch_result == 0 then
		print("Could not launch the scanner on the target.")
	else if launch_result != null then
		print("Scanner launch result: " + launch_result)
	else
		print("Scanner launched. If the menus do not accept input, use option 1 and run:")
		print(program_dir + "/scan_lib_remote " + target_ip)
	end if
end function

// Try a router bounce exploit, then fall back to a service connection from this shell.
bounce_to_internal_ip = function(shell, meta_lib, exploit_array)
	// The internal address is the only value a bounce exploit needs.
	answer = user_input("Internal IP to bounce to (b to cancel): ")
	if answer == null then return
	answer = answer.trim()
	if answer.lower() == "b" then return
	if not is_valid_target_ip(answer) then
		print("Invalid IP address: " + answer)
		return
	end if
	if not is_lan_ip(answer) then
		print("Warning: " + answer + " is not a LAN address. Bounce exploits expect an internal IP.")
	end if

	// Discover the target's real services instead of assuming SSH is on port 22.
	records = discover_lan_ports(answer)
	if records != null and records.len() > 0 then
		print("\nPorts reported for " + answer + ":")
		index = 0
		for record in records
			print("(" + index + ") " + record.port + " " + record.service + " " + record.version)
			index = index + 1
		end for
		port_choice = select_index("Choose a port to bounce through (q to skip): ", records.len(), false)
		if port_choice >= 0 then
			chosen = records[port_choice]
			if chosen.service == "ssh" or chosen.service == "ftp" or chosen.port == 22 or chosen.port == 21 then
				ssh_user = user_input("Username: ")
				if ssh_user == null or ssh_user.trim() == "" then return
				ssh_password = user_input("Password: ")
				if ssh_password == null then return
				service = chosen.service
				if service != "ssh" and service != "ftp" then
					// Fall back to the conventional service for the selected port.
					if chosen.port == 21 then service = "ftp" else service = "ssh"
				end if
				remote = shell.connect_service(answer, chosen.port, ssh_user.trim(), ssh_password, service)
				if typeof(remote) == "shell" or typeof(remote) == "ftpshell" then
					print("Bounce succeeded on port " + chosen.port + ".")
					handle_shell_result(remote)
				else
					print("Bounce failed on port " + chosen.port + ": " + remote)
				end if
				return
			else
				print("Port " + chosen.port + " is " + chosen.service + ", not an SSH/FTP shell service.")
				print("Use the terminal or Browser for it, or scan that service library with scan_lib.")
			end if
		end if
	else
		print("Could not discover open ports on " + answer + ".")
	end if

	// A bounce exploit runs against a router library and receives a LAN IP as its extra value.
	if meta_lib != null and exploit_array != null and meta_lib.lib_name == "kernel_router.so" then
		print("Trying router bounce exploits for " + answer + "...")
		for item in exploit_array
			for exploit in item.exploits
				result = meta_lib.overflow(item.memory, exploit.keyword, answer)
				if result == null then continue
				result_type = typeof(result)
				if result_type == "computer" then
					// Verify the returned computer is the requested LAN target when the game reports it.
					if result.local_ip != null and result.local_ip != answer then
						print("Bounce returned a computer at " + result.local_ip + " instead of " + answer + ".")
						continue
					end if
					print("Bounce succeeded with " + exploit.keyword + " at " + item.memory + ".")
					handle_computer_result(result)
					return
				else if result_type == "shell" then
					print("Bounce succeeded with " + exploit.keyword + " at " + item.memory + ".")
					handle_shell_result(result)
					return
				end if
			end for
		end for
		print("No router bounce exploit reached " + answer + ".")
	else
		// A non-router library cannot provide the bounce payload.
		if meta_lib != null then
			print("The scanned library is " + meta_lib.lib_name + ", not kernel_router.so.")
		else
			print("No router library is available for a bounce exploit.")
		end if
	end if

	// Fall back to a manually supplied service port from the current machine.
	print("Falling back to a service connection from this shell...")
	ssh_user = user_input("SSH username (blank to cancel): ")
	if ssh_user == null or ssh_user.trim() == "" then return
	ssh_password = user_input("SSH password: ")
	if ssh_password == null then return
	port_answer = user_input("SSH port (default 22): ")
	port = 22
	if port_answer != null and port_answer.trim() != "" then
		port = port_answer.trim().to_int
		if typeof(port) != "number" or port < 1 or port > 65535 then
			print("Invalid port: " + port_answer)
			return
		end if
	end if
	remote = shell.connect_service(answer, port, ssh_user.trim(), ssh_password)
	if typeof(remote) == "shell" or typeof(remote) == "ftpshell" then
		print("Service bounce succeeded on port " + port + ".")
		handle_shell_result(remote)
	else
		print("Service bounce failed on port " + port + ": " + remote)
	end if
end function

handle_shell_result = function(shell, meta_lib=null, exploit_array=null)
	// Track session uploads so option 4 can remove these files after use.
	uploaded_files = []
	while true
		// The shell menu stays open until b or closed input returns to the exploit list.
		print("\nActive shell (user: " + user_color(get_shell_user(shell)) + ")")
		print("1. Open terminal with this shell")
		print("2. Open FileExplorer")
		print("3. Upload decipher and decipher Mail.txt")
		print("4. Remove uploaded files and clear traces")
		print("5. Bounce to an internal IP")
		print("6. Copy scan_lib to this shell and scan an IP")
		print("b. Back to exploit menu")
		choice = user_input("Shell option: ")
		if choice == null then
			return
		else if choice.lower() == "b" then
			return
		// Option 1 opens an interactive terminal attached to the remote shell.
		else if choice == "1" then
			print("Opening terminal...")
			shell.start_terminal
			return
		// Option 2 opens the remote file browser, uploading a local copy if needed.
		else if choice == "2" then
			file_explorer_path = prepare_log_tool(shell, "FileExplorer.exe", uploaded_files)
			if file_explorer_path then
				print("Opening FileExplorer...")
				file_explorer_result = shell.launch(file_explorer_path)
				if file_explorer_result == 0 then
					print("Could not launch FileExplorer.")
				end if
			end if
		// Option 3 uploads both decipher and its library before launching on remote mail.
		else if choice == "3" then
			home_users = get_shell_home_users(shell)
			if home_users == null then
				print("Could not read the /home folder from this shell.")
			else if home_users.len() == 0 then
				print("No user folders were found in /home.")
			else
				print("\nUsers in /home:")
				index = 0
				for home_user in home_users
					print("(" + index + ") " + home_user.name)
					index = index + 1
				end for
				user_choice = select_index("Choose a user to decipher Mail.txt (q to cancel): ", home_users.len(), false)
				if user_choice >= 0 then
					// The chosen user's mail file is the path decipher will be run on.
					user_name = home_users[user_choice].name
					mail_path = "/home/" + user_name + "/Config/Mail.txt"
					// decipher and its shared library may live in /usr/bin, /bin, or the bundled tools folder.
					local_decipher_path = find_local_app("decipher")
					local_crypto_path = find_local_app("crypto.so")
					if not local_decipher_path then
						print("Could not find the local decipher app in /usr/bin, /bin, or " + current_path + "/tools/.")
					else if not local_crypto_path then
						print("Could not find the local crypto.so dependency in /usr/bin, /bin, or " + current_path + "/tools/.")
					else
						// Stage both files in one remote folder keyed by the target user.
						remote_tools_path = "/home/guest/scan_lib_" + user_name + "/"
						print("Preparing upload folder " + remote_tools_path + "...")
						shell.launch("/bin/mkdir", remote_tools_path)
						remote_decipher_path = remote_tools_path + "decipher"
						remote_crypto_path = remote_tools_path + "crypto.so"
						uploaded_files.push(remote_decipher_path)
						uploaded_files.push(remote_crypto_path)
						print("Uploading decipher and crypto.so...")
						// Check each transfer independently; partial uploads can remain on error.
						upload_decipher_result = upload_file(local_decipher_path, remote_tools_path, shell)
						upload_crypto_result = upload_file(local_crypto_path, remote_tools_path, shell)
						if upload_decipher_result == true and upload_crypto_result == true then
							print("Decipher uploaded. Running it on " + mail_path + "...")
							launch_result = shell.launch(remote_decipher_path, mail_path)
							if launch_result == null then
								print("Decipher launched successfully.")
							else if launch_result == 0 then
								print("Could not launch decipher on the target.")
							else
								print("Decipher launch result: " + launch_result)
							end if
						else
							if upload_decipher_result != true then
								print("Could not upload decipher: " + upload_decipher_result)
							end if
							if upload_crypto_result != true then
								print("Could not upload crypto.so: " + upload_crypto_result)
							end if
						end if
					end if
				end if
			end if
		// Option 4 opens trace tools and then removes any temporary uploads.
		else if choice == "4" then
				// Clear earlier session uploads before staging the log tools.
			clear_uploaded_files(shell, uploaded_files)
			file_explorer_result = 0
			log_viewer_result = 0
			log_viewer_path = prepare_log_tool(shell, "LogViewer.exe", uploaded_files)
			file_explorer_path = prepare_log_tool(shell, "FileExplorer.exe", uploaded_files)
				// FileExplorer opens first; LogViewer is spaced out by two seconds.
			if file_explorer_path then
				print("Opening FileExplorer...")
				file_explorer_result = shell.launch(file_explorer_path)
				if file_explorer_result == 0 then
					print("Could not launch FileExplorer.")
				end if
			end if
			if log_viewer_path then
				if file_explorer_path then
					wait(2)
				end if
				print("Opening LogViewer...")
				log_viewer_result = shell.launch(log_viewer_path)
				if log_viewer_result == 0 then
					print("Could not launch LogViewer.")
				end if
			end if
				// Remove the staged tool copies once both launch attempts are done.
			clear_uploaded_files(shell, uploaded_files)
				// Only print the cleanup walkthrough when both tools were available.
			if file_explorer_path and log_viewer_path and file_explorer_result != 0 and log_viewer_result != 0 then
				print("In FileExplorer, open /var/system.log with LogViewer.")
				print("Refresh the log after cleanup, then remove shell obtained or file deleted entries that include your IP address.")
				print("Do not delete the whole log. If an active trace is running, clear the indicated entries and disconnect before its countdown ends.")
			else
				print("Could not prepare or launch both log applications. Review the errors above and try again.")
			end if
		// Option 5 pivots to another machine on the target's internal network.
		else if choice == "5" then
			bounce_to_internal_ip(shell, meta_lib, exploit_array)
		// Option 6 runs the scanner from the target shell so network calls originate there.
		else if choice == "6" then
			run_scanner_on_shell(shell)
		else
			print("Choose 1, 2, 3, 4, 5, 6, or b.")
		end if
	end while
end function
